# 复制为 .env 并填写；不要把真实密钥提交到仓库。
# 复制后可以 `export $(grep -v '^#' .env | xargs)` 在本地临时加载。

# OpenAI 兼容接口地址。DeepSeek 用 https://api.deepseek.com/v1
AI_API_BASE=https://api.deepseek.com/v1
# 服务端密钥，只在后端使用，绝不出现在前端或仓库里
AI_API_KEY=
# 模型名，例如 deepseek-chat / gpt-4o-mini
AI_MODEL=deepseek-chat

# 允许调用本 API 的站点来源（逗号分隔，不要带结尾斜杠）
ALLOWED_ORIGINS=https://verity077.github.io

PORT=8787
AI_TIMEOUT_SECONDS=120

# 与前端 _config.yml 中的限制保持一致
MAX_FILES=5
MAX_FILE_MB=20
MAX_TOTAL_MB=40
MAX_EXTRACTED_CHARS=120000
RATE_LIMIT_PER_HOUR=20
MAX_CONCURRENT_JOBS=2

# 仅本地联调：设为 1 时返回模拟课件，不调用真实模型。生产环境保持 0。
AI_MOCK=0
